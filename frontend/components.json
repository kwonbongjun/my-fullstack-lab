{
  "$schema": "https://ui.shadcn.com/schema.json",
  "_comment": "💡 [shadcn/ui 설정 지도] CLI로 컴포넌트를 추가할 때(pnpm dlx shadcn add ...) 어디에 설치할지, 어떤 CSS 변수와 별칭(alias)을 쓸지 정의합니다.",
  "style": "base-nova",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.ts",
    "css": "src/app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {}
}
